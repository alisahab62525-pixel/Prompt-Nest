rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == 'malikbilal33877@gmail.com')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles & settings
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();

      // Bookmarks subcollection
      match /bookmarks/{promptId} {
        allow read, write: if true;
      }

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if true;
      }
    }

    // Prompts marketplace
    match /prompts/{promptId} {
      allow read, write: if true;

      // Prompt likes subcollection
      match /likes/{userId} {
        allow read, write: if true;
      }
    }

    // Reports collection
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Global site settings & copy collection
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
